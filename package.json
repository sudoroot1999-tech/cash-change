{
  "name": "crypto-exchange-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Next-generation cryptocurrency exchange platform",
  "workspaces": [
    "libs/*",
    "services/*",
    "apps/web/*",
    "apps/packages/*"
  ],
  "scripts": {
    "dev": "docker compose up -d",
    "dev:down": "docker compose down",
    "dev:logs": "docker compose logs -f",
    "build:all": "npm run build --workspaces --if-present",
    "test": "jest",
    "test:unit": "jest --testPathPattern=\\.spec\\.ts$ --passWithNoTests",
    "test:integration": "jest --testPathPattern=tests/integration --passWithNoTests",
    "test:e2e": "jest --testPathPattern=tests/e2e --passWithNoTests",
    "test:cov": "jest --coverage --passWithNoTests",
    "test:watch": "jest --watch",
    "test:all": "npm run test --workspaces --if-present",
    "lint:all": "npm run lint --workspaces --if-present",
    "infra": "docker compose up -d postgres mongodb redis timescaledb rabbitmq kafka kafka-ui minio --build",
    "web": "docker compose up -d nginx ",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\""
  },
  "devDependencies": {
    "@pact-foundation/pact": "^16.0.4",
    "@playwright/test": "^1.40.0",
    "@types/jest": "^29.5.11",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.10.0",
    "@types/supertest": "^2.0.16",
    "@types/ws": "^8.5.10",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0",
    "ws": "^8.14.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@nestjs/cli": "11.0.14",
    "@types/express": "^4.17.25",
    "express": "^5.2.1",
    "nodemailer": "7.0.12",
    "reflect-metadata": "0.2.2"
  }
}