{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "declaration": true,
    "rootDir": "./src",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "lib": ["dom", "ES2022"],
    "skipLibCheck": true,
  },
  "include": ["src/**/*"],
  "exclude": [ "dist", "test", "**/*.spec.ts", "**/*.test.ts"]
}
