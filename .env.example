# Environment Configuration
NODE_ENV=development

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=exchange_user
POSTGRES_PASSWORD=exchange_dev_password
POSTGRES_DB=exchange

# MongoDB
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=mongo_dev_password
MONGO_DB=exchange_analytics

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

#Minio
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_dev_password

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=exchange
RABBITMQ_PASSWORD=rabbitmq_dev_password

# JWT Configuration
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# API Configuration
API_PORT=3000
API_PREFIX=api/v1

# Blockchain (Testnet)
ETH_RPC_URL=https://sepolia.infura.io/v3/YOUR_API_KEY
BSC_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
POLYGON_RPC_URL=https://rpc-mumbai.maticvigil.com