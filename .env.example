# Environment Configuration
NODE_ENV=development

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=exchange_user
POSTGRES_PASSWORD=exchange_dev_password
POSTGRES_DB=exchange

# MongoDB
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=mongo_dev_password
MONGO_DB=exchange_analytics

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=exchange
RABBITMQ_PASSWORD=rabbitmq_dev_password

# JWT Configuration
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# API Configuration
API_PORT=3000
API_PREFIX=api/v1

# Blockchain (Testnet)
ETH_RPC_URL=https://sepolia.infura.io/v3/YOUR_API_KEY
BSC_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
POLYGON_RPC_URL=https://rpc-mumbai.maticvigil.com

# Service Ports
USER_SERVICE_PORT=3001
AUTH_SERVICE_PORT=3002
WALLET_SERVICE_PORT=3003
TRADING_SERVICE_PORT=3004
MARKET_DATA_PORT=3005
NOTIFICATION_PORT=3006
MATCHING_ENGINE_PORT=3010
