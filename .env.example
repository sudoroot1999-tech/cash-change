# Environment Configuration
NODE_ENV=development

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=exchange_user
POSTGRES_PASSWORD=exchange_dev_password
POSTGRES_DB=exchange

# MongoDB
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=mongo_dev_password
MONGO_DB=exchange

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

#Minio
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_dev_password

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=exchange
RABBITMQ_PASSWORD=rabbitmq_dev_password

#Kafka
KAFKA_HOST_PORT=9092
KAFKA_BROKER_HOST=kafka
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_BROKERS=kafka:9092

# JWT Configuration
JWT_SECRET= dev-jwt-secret
JWT_EXPIRES_IN= 15m
JWT_REFRESH_EXPIRES_IN= 7d
# Cookies
COOKIE_SECRET= dev-cookie-secret
# KMS
AWS_KMS_ENABLED= false
AWS_REGION= us-east-1
AWS_ACCESS_KEY_ID= your-aws-access-key-id
AWS_SECRET_ACCESS_KEY= your-aws-secret-access-key
AWS_KMS_KEY_ID= your-kms-key-id
# Ethereum Configuration
ETHEREUM_RPC_URL= https://eth-mainnet.g.alchemy.com/v2/your-api-key
ETHEREUM_CONFIRMATIONS= 12
# Bitcoin Configuration
BITCOIN_RPC_URL= http://localhost:8332
BITCOIN_RPC_USER= bitcoin
BITCOIN_RPC_PASSWORD= bitcoin
BITCOIN_NETWORK= mainnet
BITCOIN_CONFIRMATIONS= 6
# BSC Configuration
BSC_RPC_URL= https://bsc-dataseed.binance.org
BSC_CONFIRMATIONS= 15
# Polygon Configuration
POLYGON_RPC_URL= https://polygon-rpc.com
POLYGON_CONFIRMATIONS= 128
# Solana Configuration
SOLANA_RPC_URL= https://api.mainnet-beta.solana.com
SOLANA_NETWORK= mainnet-beta
SOLANA_CONFIRMATIONS= 1
# Rate Limiting
RATE_LIMIT_TTL= 60
RATE_LIMIT_MAX= 100
# API Configuration
API_PORT= 3000
API_PREFIX= api/v1