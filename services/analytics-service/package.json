{
  "name": "@exchange/analytics-service",
  "version": "1.0.0",
  "description": "Advanced analytics and reporting service for the exchange platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "migrate": "knex migrate:latest --knexfile src/config/knexfile.ts",
    "migrate:rollback": "knex migrate:rollback --knexfile src/config/knexfile.ts",
    "seed": "knex seed:run --knexfile src/config/knexfile.ts",
    "etl:run": "ts-node src/etl/runner.ts",
    "generate:report": "ts-node src/scripts/generate-report.ts"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "dotenv": "^16.3.1",
    "pg": "^8.11.3",
    "knex": "^3.0.1",
    "redis": "^4.6.10",
    "ioredis": "^5.3.2",
    "elasticsearch": "^16.7.3",
    "@elastic/elasticsearch": "^8.10.0",
    "@clickhouse/client": "^0.2.5",
    "bull": "^4.11.5",
    "axios": "^1.6.0",
    "winston": "^3.11.0",
    "express-rate-limit": "^7.1.3",
    "compression": "^1.7.4",
    "express-validator": "^7.0.1",
    "date-fns": "^2.30.0",
    "lodash": "^4.17.23",
    "pdfkit": "^0.13.0",
    "exceljs": "^4.4.0",
    "nodemailer": "^7.0.11",
    "cron": "^3.1.6",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "zod": "^3.22.4",
    "node-cron": "^3.0.3",
    "uuid": "^9.0.1",
    "chart.js": "^4.4.0",
    "canvas": "^3.2.1"
  },
  "devDependencies": {
    "@nestjs/typeorm": "^10.0.1",
    "@types/compression": "^1.7.4",
    "@types/lodash": "^4.14.200",
    "@types/pdfkit": "^0.17.3",
    "@types/nodemailer": "^6.4.14",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/jest": "^29.5.6",
    "@types/supertest": "^2.0.15",
    "@typescript-eslint/eslint-plugin": "^6.9.1",
    "@typescript-eslint/parser": "^6.9.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2",
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "supertest": "^6.3.3",
    "eslint": "^8.52.0"
  },
  "pnpm": {
    "overrides": {
      "canvas": "npm:@napi-rs/canvas@0.1.88"
    }
  }
}