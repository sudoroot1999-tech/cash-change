{
    "name": "@exchange/nft-marketplace",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "build": "nest build",
        "dev": "nest start --watch",
        "start": "node dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
        "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "type-check": "tsc --noEmit",
        "clean": "rm -rf dist",
        "migration:generate": "typeorm-ts-node-esm migration:generate",
        "migration:run": "typeorm-ts-node-esm migration:run",
        "migration:revert": "typeorm-ts-node-esm migration:revert",
        "compile:contracts": "cd contracts && npx hardhat compile",
        "test:contracts": "cd contracts && npx hardhat test"
    },
    "dependencies": {
        "@nestjs/common": "^10.3.0",
        "@nestjs/config": "^3.1.1",
        "@nestjs/core": "^10.3.0",
        "@nestjs/platform-express": "^10.3.0",
        "@nestjs/swagger": "^7.2.0",
        "@nestjs/typeorm": "^10.0.1",
        "@nestjs/schedule": "^4.0.0",
        "@nestjs/bull": "^10.0.1",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "pg": "^8.11.3",
        "ethers": "^6.10.0",
        "axios": "^1.6.5",
        "reflect-metadata": "^0.2.1",
        "rxjs": "^7.8.1",
        "typeorm": "^0.3.19",
        "bignumber.js": "^9.1.2",
        "ipfs-http-client": "^60.0.1",
        "multiformats": "^13.0.0",
        "bull": "^4.12.0",
        "redis": "^4.6.11"
    },
    "devDependencies": {
        "@nestjs/cli": "^10.3.0",
        "@types/node": "^20.11.5",
        "@nomicfoundation/hardhat-toolbox": "^4.0.0",
        "hardhat": "^2.19.5",
        "typescript": "^5.3.3"
    }
}