{
  "name": "@exchange/marketing-service",
  "version": "1.0.0",
  "description": "Marketing automation service with referrals, airdrops, loyalty programs, and campaigns",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "node dist/main.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "npm run typeorm migration:generate",
    "migration:run": "npm run typeorm migration:run",
    "migration:revert": "npm run typeorm migration:revert"
  },
  "dependencies": {
    "@exchange/common": "workspace:*",
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/typeorm": "^10.0.0",
    "@nestjs/swagger": "^7.1.0",
    "@nestjs/schedule": "^3.0.4",
    "@nestjs/bull": "^10.2.1",
    "@sendgrid/mail": "^8.1.0",
    "typeorm": "^0.3.17",
    "pg": "^8.11.0",
    "redis": "^4.6.0",
    "bull": "^4.12.0",
    "express": "^4.18.2",
    "dotenv": "^16.3.1",
    "class-validator": "^0.14.0",
    "class-transformer": "^0.5.1",
    "axios": "^1.6.0",
    "nanoid": "^3.3.7",
    "qrcode": "^1.5.3",
    "moment-timezone": "^0.5.43",
    "mailchimp-api-v3": "^1.15.0",
    "mixpanel": "^0.18.0",
    "segment": "^0.1.3",
    "sharp": "^0.33.0",
    "handlebars": "^4.7.8",
    "markdown-it": "^14.0.0",
    "cheerio": "^1.0.0-rc.12",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.0.0",
    "@types/bull": "^4.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "jest": "^29.5.0",
    "nodemon": "^3.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.0"
  }
}