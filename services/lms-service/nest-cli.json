{
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "plugins": [
      {
        "name": "@nestjs/swagger",
        "options": {
          "classValidatorShim": true,
          "introspectComments": true
        }
      },
      {
        "name": "@nestjs/graphql",
        "options": {
          "introspectComments": true
        }
      }
    ],
    "assets": [
      {
        "include": "../../../libs/common/proto/*.proto",
        "outDir": "dist/libs/common/proto",
        "watchAssets": true
      }
    ]
  }
}